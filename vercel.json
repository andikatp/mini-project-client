{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "outputDirectory": "build/client",
  "rewrites": [
    {
      "source": "/api/backend/(.*)",
      "destination": "https://mini-project-server-i490.onrender.com/api/v1/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
